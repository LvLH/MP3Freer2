{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MP3Freer",
  "version": "0.1.1",
  "identifier": "com.rog.mp3freer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MP3Freer",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data: http://music.163.com http://p*.music.126.net https://p*.music.126.net https://images.unsplash.com; media-src 'self' asset: https: http://music.163.com; connect-src 'self' https: http://music.163.com http://music.163.com; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$DOWNLOAD/**",
          "$MUSIC/**",
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "**/*.mp3",
          "**/*.flac",
          "**/*.wav",
          "**/*.ogg",
          "**/*.m4a",
          "**/*.lrc",
          "**/*.png",
          "**/*.jpg",
          "**/*.jpeg",
          "**/*.svg",
          "**/*.webp"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
